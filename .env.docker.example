# 통합 docker-compose.yml에서 PostgreSQL·Redis 설정만 점검할 때 사용할 선택적 변수 샘플입니다.
# 전체 스택 실행은 .env.deploy.example을 기준으로 하며, 실제 비밀번호는 저장소에 기록하지 않습니다.
POSTGRES_DB=ai_mafia
POSTGRES_MIGRATION_USER=migration_user
POSTGRES_MIGRATION_PASSWORD=change-this-local-password
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=change-this-app-password
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
